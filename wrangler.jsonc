{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usahakita",
  "main": "./src/index.tsx",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_DO",
        "class_name": "AuthDirectoryDO"
      },
      {
        "name": "TENANT_DO",
        "class_name": "TenantDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthDirectoryDO", "TenantDO"]
    }
  ],

  "observability": {
    "enabled": true
  }
}
