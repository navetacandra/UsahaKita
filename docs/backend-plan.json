{
  "plan_name": "usahakita-backend-api-plan",
  "version": "1.0.0",
  "project": {
    "name": "UsahaKita",
    "purpose": "Multi-tenant micro ERP untuk operasi material, resep, produksi, produk jadi, penjualan dan AI insight.",
    "api_version": "v1"
  },
  "platform": {
    "runtime": "Cloudflare Workers",
    "framework": "Hono",
    "build_tool": "Vite",
    "stateful_storage": "Durable Objects dengan SQLite-backed storage",
    "routing_layer": "Hono Router pada Worker",
    "tenant_isolation": "Satu Durable Object stateful instance untuk satu tenant.",
    "auth_state": "Auth/Directory Durable Object untuk user, tenant membership dan session.",
    "basis": [
      "Hono mendukung full-stack Cloudflare Workers + Vite melalui Cloudflare Vite plugin.",
      "Durable Objects menyediakan stateful compute dan strongly consistent storage yang cocok untuk koordinasi transaksi per tenant.",
      "SQLite-backed Durable Objects tersedia pada Workers dan dapat digunakan melalui SQL Storage API."
    ],
    "sources": [
      "https://hono.dev/docs/getting-started/cloudflare-workers-vite",
      "https://developers.cloudflare.com/workers/vite-plugin/",
      "https://developers.cloudflare.com/durable-objects/concepts/what-are-durable-objects/",
      "https://developers.cloudflare.com/durable-objects/get-started/"
    ]
  },
  "architecture": {
    "request_flow": [
      "Client",
      "Hono Worker",
      "Authentication middleware",
      "Resolve tenant_id",
      "Resolve Tenant Durable Object",
      "Execute domain command/query",
      "Validate business rules",
      "Atomic SQLite transaction",
      "Return API response"
    ],
    "durable_objects": {
      "AuthDirectory": {
        "purpose": [
          "Global user identity",
          "Unique email lookup",
          "User-to-tenant mapping",
          "Session management"
        ]
      },
      "Tenant": {
        "purpose": [
          "Business profile",
          "Materials",
          "Products",
          "Inventory movements",
          "Stock opname",
          "BoM",
          "Production",
          "Sales",
          "Dashboard aggregations",
          "Saved AI insights"
        ],
        "naming": "Durable Object ID derived deterministically from tenant_id."
      }
    },
    "consistency_rule": "Semua perubahan yang memengaruhi lebih dari satu entity dalam tenant harus dilakukan dalam satu transaksi SQLite pada Tenant Durable Object.",
    "tenant_rule": "tenant_id tidak dipercaya dari body request. Tenant selalu berasal dari authenticated session.",
    "authorization": "Setiap tenant-scoped endpoint hanya dapat mengakses Tenant DO berdasarkan tenant_id session.",
    "rpc_note": "Cloudflare Workers dan Durable Objects saat ini mendukung native RPC; gunakan RPC hanya untuk komunikasi internal yang benar-benar memerlukannya, sedangkan public API tetap menggunakan HTTP/Hono agar kontrak client stabil."
  },
  "security": {
    "password": {
      "storage": "Password plaintext tidak pernah disimpan.",
      "recommended_hash": "PBKDF2-HMAC-SHA-256 melalui Web Crypto API dengan random salt dan cost parameter yang dapat dikonfigurasi.",
      "minimum_rule": "Password minimal 8 karakter."
    },
    "session": {
      "transport": "HttpOnly Secure SameSite cookie",
      "token": "Opaque random session token.",
      "storage": "Simpan hash token/session identifier pada AuthDirectory DO.",
      "expiration": "Session memiliki expiry.",
      "logout": "Session di-revoke server-side."
    },
    "input_validation": [
      "Schema validation di boundary API.",
      "Validasi UUID/ID format.",
      "Validasi quantity > 0 untuk transaksi.",
      "Validasi precision unit.",
      "Validasi stock availability.",
      "Validasi ownership seluruh entity tenant."
    ],
    "ai_security": [
      "Jangan kirim password, session token, atau secret ke model.",
      "AI hanya menerima business context yang sudah diagregasi.",
      "Tenant data harus dibatasi berdasarkan tenant_id.",
      "AI output tidak boleh menjadi sumber angka bisnis.",
      "Calculation dan validation dilakukan oleh backend sebelum AI."
    ]
  },
  "data_model": {
    "users": {
      "fields": [
        "id",
        "email",
        "password_hash",
        "password_salt",
        "created_at"
      ]
    },
    "tenants": {
      "fields": [
        "id",
        "name",
        "description",
        "created_at",
        "updated_at"
      ]
    },
    "tenant_members": {
      "fields": [
        "tenant_id",
        "user_id",
        "role",
        "created_at"
      ],
      "initial_role": "OWNER"
    },
    "sessions": {
      "fields": [
        "id",
        "user_id",
        "tenant_id",
        "token_hash",
        "expires_at",
        "created_at",
        "revoked_at"
      ]
    },
    "materials": {
      "fields": [
        "id",
        "name",
        "unit",
        "quantity_precision",
        "current_stock",
        "minimum_stock",
        "created_at",
        "updated_at"
      ]
    },
    "products": {
      "fields": [
        "id",
        "name",
        "unit",
        "current_stock",
        "minimum_stock",
        "created_at",
        "updated_at"
      ]
    },
    "inventory_movements": {
      "fields": [
        "id",
        "item_type",
        "item_id",
        "movement_type",
        "quantity",
        "stock_before",
        "stock_after",
        "reason_type",
        "reason_note",
        "reference_type",
        "reference_id",
        "created_at"
      ],
      "movement_types": [
        "IN",
        "OUT",
        "PRODUCTION_CONSUMPTION",
        "PRODUCTION_OUTPUT",
        "SALE",
        "STOCK_OPNAME"
      ],
      "reason_types": [
        "PURCHASE",
        "DAMAGED",
        "EXPIRED",
        "SAMPLE",
        "INTERNAL_USE",
        "LOST",
        "OTHER",
        "STOCK_OPNAME"
      ]
    },
    "boms": {
      "fields": [
        "id",
        "name",
        "product_id",
        "output_quantity",
        "output_unit",
        "selling_price_per_unit",
        "created_at",
        "updated_at"
      ]
    },
    "bom_materials": {
      "fields": [
        "bom_id",
        "material_id",
        "quantity"
      ]
    },
    "productions": {
      "fields": [
        "id",
        "bom_id",
        "product_id",
        "target_output_quantity",
        "actual_output_quantity",
        "bom_multiplier",
        "note",
        "created_at"
      ]
    },
    "production_materials": {
      "fields": [
        "production_id",
        "material_id",
        "calculated_quantity",
        "actual_quantity"
      ]
    },
    "stock_opnames": {
      "fields": [
        "id",
        "item_type",
        "item_id",
        "system_quantity",
        "actual_quantity",
        "difference",
        "note",
        "created_at"
      ]
    },
    "sales": {
      "fields": [
        "id",
        "total",
        "created_at"
      ]
    },
    "sale_items": {
      "fields": [
        "sale_id",
        "product_id",
        "quantity",
        "unit_price",
        "subtotal"
      ]
    },
    "ai_insights": {
      "fields": [
        "id",
        "period_from",
        "period_to",
        "data_as_of",
        "generated_at",
        "prompt_version",
        "content_json",
        "model_metadata_json"
      ]
    }
  },
  "core_business_rules": {
    "inventory": {
      "material": {
        "manual_in": true,
        "manual_out": true,
        "production_consumption": true,
        "stock_opname": true
      },
      "product": {
        "manual_in": false,
        "manual_out": true,
        "production_output": true,
        "sale_output": true
      }
    },
    "bom": {
      "model": "Satu BoM menghasilkan satu produk dengan output_quantity tertentu.",
      "output_quantity": "Jumlah produk yang dihasilkan oleh satu kali resep.",
      "selling_price": "Harga jual barang jadi per satuan.",
      "material_quantity": "Jumlah material yang dibutuhkan untuk satu output_quantity."
    },
    "production": {
      "formula": {
        "bom_multiplier": "target_output_quantity / bom.output_quantity",
        "calculated_material_quantity": "bom_material.quantity * bom_multiplier"
      },
      "override": {
        "allowed": true,
        "stored_fields": [
          "calculated_quantity",
          "actual_quantity"
        ],
        "stock_consumption": "actual_quantity"
      },
      "actual_output": {
        "allowed": true,
        "stock_increase": "actual_output_quantity"
      },
      "stock_validation": "actual_quantity seluruh material harus <= current_stock saat commit.",
      "atomicity": "Consumption material, output product, production record dan inventory movements harus commit atau rollback bersama."
    },
    "stock_opname": {
      "formula": "difference = actual_quantity - system_quantity",
      "effect": "current_stock menjadi actual_quantity.",
      "audit": "Selisih dibuat sebagai inventory movement STOCK_OPNAME."
    },
    "sales": {
      "stock_rule": "Quantity sale tidak boleh melebihi current product stock.",
      "price_rule": "Unit price harus diambil dari konfigurasi harga produk/BoM pada server dan dapat disnapshot pada sale item.",
      "atomicity": "Sale record, sale items dan stock reduction harus atomic."
    },
    "ai_insights": {
      "generation": "On demand only.",
      "persistence": "Setiap generation membuat record insight baru.",
      "staleness": {
        "definition": "latest_business_activity_at > insight.data_as_of",
        "purpose": "Memberi tahu user bahwa insight mungkin tidak merepresentasikan transaksi terbaru."
      },
      "calculation_rule": "Backend analytics engine menghitung angka; AI hanya menginterpretasikan hasil."
    }
  },
