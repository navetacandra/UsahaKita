{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usahakita",
  "main": "./apps/api/src/index.tsx",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_DO",
        "class_name": "AuthDirectoryDO"
      },
      {
        "name": "TENANT_DO",
        "class_name": "TenantDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthDirectoryDO", "TenantDO"]
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "AI_BASE_URL": "https://api.z.ai",
    "AI_MODELS": "glm-4.7-flash,glm-4.5-flash",
    "AI_API_KEYS": "141a0cf50f3d460591fb93ee80b0da22.LkdKF5uR4ntlA2sk,8fb527e6c365470a877631026e248cd6.rBOdTTjHJccBKwXW,592982172ee1429e9d846071b270e4d7.wVEOPTBF82IgQZgS,cf9cc118b1c44e1da7b950d01c409d3f.tXLzj4dG8lvlBz7T"
  },

  "build": {
    "command": "node scripts/build-docs.cjs"
  }
}
